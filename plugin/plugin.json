{
  "schema_version": 3,
  "id": "community.guangya-strm",
  "name": "光鸭 STRM 同步",
  "version": "1.0.3",
  "author": "yy1105384898",
  "description": "单账号登录、整理目录增量同步、Emby 刷新、元数据下载及文件清理。",
  "requires": {
    "api": "3.8"
  },
  "ui": {
    "entry": "ui/page.js"
  },
  "menu": {
    "title": "光鸭 STRM",
    "order": 80
  },
  "settings": [
    {
      "key": "page_size",
      "label": "每页读取数量",
      "type": "number",
      "default": 100
    }
  ],
  "jobs": [
    {
      "id": "library-refresh",
      "entry": "jobs/library-refresh.js",
      "handler": "run",
      "interval_seconds": 30,
      "timeout_seconds": 90,
      "allow_overlap": false,
      "queue": false,
      "title": "光鸭媒体库刷新"
    },
    {
      "id": "source-change",
      "entry": "jobs/source-change.js",
      "handler": "run",
      "timeout_seconds": 45,
      "allow_overlap": false,
      "queue": false,
      "title": "光鸭源目录变化接收"
    },
    {
      "id": "organize-event",
      "entry": "jobs/organize-event.js",
      "handler": "run",
      "timeout_seconds": 30,
      "allow_overlap": true,
      "queue": false,
      "title": "光鸭整理事件接收"
    },
    {
      "id": "cloud-cleanup",
      "entry": "jobs/cloud-cleanup.js",
      "handler": "run",
      "recover": "recover",
      "timeout_seconds": 7200,
      "allow_overlap": false,
      "title": "光鸭文件清理"
    },
    {
      "id": "cleanup-scheduler",
      "entry": "jobs/cleanup-scheduler.js",
      "handler": "run",
      "timeout_seconds": 45,
      "interval_seconds": 60,
      "allow_overlap": false,
      "queue": false,
      "title": "光鸭清理定时检查"
    },
    {
      "id": "sync",
      "entry": "jobs/sync.js",
      "handler": "run",
      "timeout_seconds": 3600,
      "allow_overlap": false,
      "title": "同步光鸭 STRM"
    },
    {
      "id": "scheduler",
      "entry": "jobs/scheduler.js",
      "handler": "run",
      "timeout_seconds": 45,
      "interval_seconds": 15,
      "allow_overlap": false,
      "queue": false,
      "title": "光鸭整理及定时检查"
    },
    {
      "id": "duplicate-source",
      "entry": "jobs/duplicate-source.js",
      "handler": "run",
      "recover": "recover",
      "timeout_seconds": 600,
      "allow_overlap": false,
      "title": "光鸭重复来源清理"
    }
  ],
  "events": [
    {
      "event": "host",
      "job": "organize-event",
      "types": [
        "library_organize_*"
      ]
    }
  ],
  "http": {
    "entry": "jobs/http.js",
    "handler": "handle",
    "timeout_seconds": 60,
    "public": true
  },
  "declared_usage": {
    "apis": [
      "光鸭 Web API：短信登录、Token 刷新、目录列表、下载、播放地址与文件删除",
      "DIAN-115 插件任务提交 API"
    ],
    "sites": [
      "https://api.guangyapan.com",
      "https://account.guangyapan.com"
    ],
    "files": [
      "插件自有映射和下载缓存",
      "用户配置的本地 STRM 和元数据输出目录",
      "用户在清单中确认删除的本插件孤立输出文件"
    ],
    "risk": "保存光鸭登录凭证；扫描选定目录生成 STRM 并按配置下载元数据。文件清理页签直接删除光鸭云端文件和空目录：手动先预览确认，定时按用户明确开启的规则执行。删除前核对账号、规则、父目录和文件状态；清理根目录及用户排除目录始终保留，结果不明时停止且不自动重试。原孤立输出清理仍仅删除本插件记录的本地文件。"
  }
}
